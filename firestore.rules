rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil user: hanya pemilik akun yang boleh baca/tulis datanya sendiri
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Daftar ujian: semua user login boleh baca (untuk tampil di dashboard),
    // tapi tidak ada yang boleh menulis dari client (isi lewat Firebase Console saja).
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Jawaban ujian: user hanya boleh baca/tulis submission miliknya sendiri
    // (id dokumen wajib diawali {uid}_ sesuai konvensi app.js).
    match /submissions/{subId} {
      allow read, write: if request.auth != null
        && subId.matches(request.auth.uid + '_.*');
    }
  }
}
